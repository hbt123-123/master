# 先使用 .env，本地开发可直接配置；后续可改为系统环境变量。
# 复制本文件为 .env 后填写真实值。

LLM_PROVIDER=dashscope_openai
LLM_BASE_URL=<PLACEHOLDER_BASE_URL>
LLM_MODEL=<PLACEHOLDER_MODEL>
LLM_API_KEY=<PLACEHOLDER_API_KEY>
LLM_TIMEOUT_SEC=20

# 协议切换：openai / anthropic
LLM_PROTOCOL=openai

# 协议专用配置（不填则回退到上面的 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY）
LLM_BASE_URL_OPENAI=<PLACEHOLDER_BASE_URL_OPENAI>
LLM_MODEL_OPENAI=<PLACEHOLDER_MODEL_OPENAI>
LLM_API_KEY_OPENAI=<PLACEHOLDER_API_KEY_OPENAI>

LLM_BASE_URL_ANTHROPIC=<PLACEHOLDER_BASE_URL_ANTHROPIC>
LLM_MODEL_ANTHROPIC=<PLACEHOLDER_MODEL_ANTHROPIC>
LLM_API_KEY_ANTHROPIC=<PLACEHOLDER_API_KEY_ANTHROPIC>
LLM_ANTHROPIC_VERSION=2023-06-01

# 深度思考开关
LLM_DEEP_THINKING=false
LLM_REASONING_EFFORT=medium
LLM_THINKING_BUDGET_TOKENS=1024
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SEC=120
